/*
# Agentic Career Navigator — Core Schema

## Overview
Creates the full relational schema for the Agentic Career Navigator platform.
This is a multi-user application with sign-in, so all user-owned tables are
scoped to the authenticated user via `user_id` columns (defaulting to auth.uid())
and protected with owner-scoped RLS policies.

## New Tables

### profiles
Extends auth.users with the user's career-profile data.
- id (uuid, PK, references auth.users)
- full_name (text)
- education (text)
- education_field (text) — e.g. "Computer Science"
- experience_years (int, default 0)
- experience_summary (text)
- interests (text[]) — preferred career domains/topics
- target_career_id (uuid, nullable, references careers)
- created_at, updated_at

### skills
Catalog of all known skills.
- id (uuid, PK)
- name (text, unique)
- category (text) — e.g. "Programming", "Data Science", "Tools"
- description (text)

### user_skills
A user's self-assessed skill levels (1-5).
- id (uuid, PK)
- user_id (uuid, references auth.users)
- skill_id (uuid, references skills)
- skill_level (int, 1-5)
- UNIQUE(user_id, skill_id)

### careers
Catalog of career roles.
- id (uuid, PK)
- name (text, unique)
- description (text)
- domain (text)

### career_skills
Skills required for each career, with required level and priority.
- id (uuid, PK)
- career_id (uuid, references careers)
- skill_id (uuid, references skills)
- required_level (int, 1-5)
- priority (text) — 'high' | 'medium' | 'low'
- UNIQUE(career_id, skill_id)

### learning_resources
Resources linked to skills.
- id (uuid, PK)
- skill_id (uuid, references skills)
- title (text)
- platform (text)
- resource_type (text) — 'course' | 'tutorial' | 'documentation' | 'project' | 'practice' | 'certification'
- difficulty (text) — 'beginner' | 'intermediate' | 'advanced'
- url (text)
- duration_hours (int)
- is_free (boolean, default true)

### industry_trends
Trend data for skills. Labeled via `source` as 'demo' or 'live'.
- id (uuid, PK)
- skill_name (text)
- demand_level (text) — 'high' | 'medium' | 'low' | 'declining'
- trend_score (numeric 0-100)
- source (text) — 'demo' | 'live'
- notes (text)
- updated_at (timestamptz)

### recommendations
Saved career compatibility scores generated by the Career Agent.
- id (uuid, PK)
- user_id (uuid, references auth.users)
- career_id (uuid, references careers)
- compatibility_score (numeric 0-100)
- skill_match (numeric 0-100)
- interest_match (numeric 0-100)
- education_match (numeric 0-100)
- experience_match (numeric 0-100)
- industry_demand (numeric 0-100)
- explanation (text)
- created_at (timestamptz)

### progress
Tracks a user's learning progress per skill.
- id (uuid, PK)
- user_id (uuid, references auth.users)
- skill_id (uuid, references skills)
- progress_percentage (int 0-100, default 0)
- status (text) — 'not_started' | 'in_progress' | 'completed'
- updated_at (timestamptz)
- UNIQUE(user_id, skill_id)

### user_projects
Projects added by the user to their profile.
- id (uuid, PK)
- user_id (uuid, references auth.users)
- title (text)
- description (text)
- url (text)
- technologies (text[])
- created_at (timestamptz)

### user_certifications
Certifications added by the user.
- id (uuid, PK)
- user_id (uuid, references auth.users)
- title (text)
- issuer (text)
- date (text)
- created_at (timestamptz)

## Security
- RLS enabled on every user-owned table with owner-scoped CRUD policies.
- Catalog tables (skills, careers, career_skills, learning_resources, industry_trends)
  are readable by authenticated users (reference data).
*/

-- ============ CATALOG: skills ============
CREATE TABLE IF NOT EXISTS skills (
  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  name text UNIQUE NOT NULL,
  category text NOT NULL DEFAULT 'General',
  description text DEFAULT ''
);

-- ============ CATALOG: careers ============
CREATE TABLE IF NOT EXISTS careers (
  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  name text UNIQUE NOT NULL,
  description text DEFAULT '',
  domain text DEFAULT ''
);

-- ============ career_skills ============
CREATE TABLE IF NOT EXISTS career_skills (
  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  career_id uuid NOT NULL REFERENCES careers(id) ON DELETE CASCADE,
  skill_id uuid NOT NULL REFERENCES skills(id) ON DELETE CASCADE,
  required_level int NOT NULL DEFAULT 3 CHECK (required_level BETWEEN 1 AND 5),
  priority text NOT NULL DEFAULT 'medium' CHECK (priority IN ('high','medium','low')),
  UNIQUE(career_id, skill_id)
);

-- ============ learning_resources ============
CREATE TABLE IF NOT EXISTS learning_resources (
  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  skill_id uuid NOT NULL REFERENCES skills(id) ON DELETE CASCADE,
  title text NOT NULL,
  platform text DEFAULT '',
  resource_type text NOT NULL DEFAULT 'course' CHECK (resource_type IN ('course','tutorial','documentation','project','practice','certification')),
  difficulty text NOT NULL DEFAULT 'beginner' CHECK (difficulty IN ('beginner','intermediate','advanced')),
  url text DEFAULT '',
  duration_hours int DEFAULT 10,
  is_free boolean DEFAULT true
);

-- ============ industry_trends ============
CREATE TABLE IF NOT EXISTS industry_trends (
  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  skill_name text NOT NULL,
  demand_level text NOT NULL DEFAULT 'medium' CHECK (demand_level IN ('high','medium','low','declining')),
  trend_score numeric NOT NULL DEFAULT 50 CHECK (trend_score BETWEEN 0 AND 100),
  source text NOT NULL DEFAULT 'demo' CHECK (source IN ('demo','live')),
  notes text DEFAULT '',
  updated_at timestamptz DEFAULT now()
);

-- ============ profiles ============
CREATE TABLE IF NOT EXISTS profiles (
  id uuid PRIMARY KEY REFERENCES auth.users(id) ON DELETE CASCADE,
  full_name text DEFAULT '',
  education text DEFAULT '',
  education_field text DEFAULT '',
  experience_years int NOT NULL DEFAULT 0,
  experience_summary text DEFAULT '',
  interests text[] DEFAULT '{}',
  target_career_id uuid REFERENCES careers(id) ON DELETE SET NULL,
  created_at timestamptz DEFAULT now(),
  updated_at timestamptz DEFAULT now()
);

-- ============ user_skills ============
CREATE TABLE IF NOT EXISTS user_skills (
  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  user_id uuid NOT NULL DEFAULT auth.uid() REFERENCES auth.users(id) ON DELETE CASCADE,
  skill_id uuid NOT NULL REFERENCES skills(id) ON DELETE CASCADE,
  skill_level int NOT NULL DEFAULT 1 CHECK (skill_level BETWEEN 1 AND 5),
  UNIQUE(user_id, skill_id)
);

-- ============ recommendations ============
CREATE TABLE IF NOT EXISTS recommendations (
  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  user_id uuid NOT NULL DEFAULT auth.uid() REFERENCES auth.users(id) ON DELETE CASCADE,
  career_id uuid NOT NULL REFERENCES careers(id) ON DELETE CASCADE,
  compatibility_score numeric NOT NULL DEFAULT 0,
  skill_match numeric NOT NULL DEFAULT 0,
  interest_match numeric NOT NULL DEFAULT 0,
  education_match numeric NOT NULL DEFAULT 0,
  experience_match numeric NOT NULL DEFAULT 0,
  industry_demand numeric NOT NULL DEFAULT 0,
  explanation text DEFAULT '',
  created_at timestamptz DEFAULT now()
);

-- ============ progress ============
CREATE TABLE IF NOT EXISTS progress (
  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  user_id uuid NOT NULL DEFAULT auth.uid() REFERENCES auth.users(id) ON DELETE CASCADE,
  skill_id uuid NOT NULL REFERENCES skills(id) ON DELETE CASCADE,
  progress_percentage int NOT NULL DEFAULT 0 CHECK (progress_percentage BETWEEN 0 AND 100),
  status text NOT NULL DEFAULT 'not_started' CHECK (status IN ('not_started','in_progress','completed')),
  updated_at timestamptz DEFAULT now(),
  UNIQUE(user_id, skill_id)
);

-- ============ user_projects ============
CREATE TABLE IF NOT EXISTS user_projects (
  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  user_id uuid NOT NULL DEFAULT auth.uid() REFERENCES auth.users(id) ON DELETE CASCADE,
  title text NOT NULL,
  description text DEFAULT '',
  url text DEFAULT '',
  technologies text[] DEFAULT '{}',
  created_at timestamptz DEFAULT now()
);

-- ============ user_certifications ============
CREATE TABLE IF NOT EXISTS user_certifications (
  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  user_id uuid NOT NULL DEFAULT auth.uid() REFERENCES auth.users(id) ON DELETE CASCADE,
  title text NOT NULL,
  issuer text DEFAULT '',
  date text DEFAULT '',
  created_at timestamptz DEFAULT now()
);

-- ============ INDEXES ============
CREATE INDEX IF NOT EXISTS idx_career_skills_career ON career_skills(career_id);
CREATE INDEX IF NOT EXISTS idx_career_skills_skill ON career_skills(skill_id);
CREATE INDEX IF NOT EXISTS idx_learning_skill ON learning_resources(skill_id);
CREATE INDEX IF NOT EXISTS idx_user_skills_user ON user_skills(user_id);
CREATE INDEX IF NOT EXISTS idx_recommendations_user ON recommendations(user_id);
CREATE INDEX IF NOT EXISTS idx_progress_user ON progress(user_id);
CREATE INDEX IF NOT EXISTS idx_user_projects_user ON user_projects(user_id);
CREATE INDEX IF NOT EXISTS idx_user_certs_user ON user_certifications(user_id);
CREATE INDEX IF NOT EXISTS idx_industry_trends_skill ON industry_trends(skill_name);

-- ============ RLS ============
ALTER TABLE skills ENABLE ROW LEVEL SECURITY;
ALTER TABLE careers ENABLE ROW LEVEL SECURITY;
ALTER TABLE career_skills ENABLE ROW LEVEL SECURITY;
ALTER TABLE learning_resources ENABLE ROW LEVEL SECURITY;
ALTER TABLE industry_trends ENABLE ROW LEVEL SECURITY;
ALTER TABLE profiles ENABLE ROW LEVEL SECURITY;
ALTER TABLE user_skills ENABLE ROW LEVEL SECURITY;
ALTER TABLE recommendations ENABLE ROW LEVEL SECURITY;
ALTER TABLE progress ENABLE ROW LEVEL SECURITY;
ALTER TABLE user_projects ENABLE ROW LEVEL SECURITY;
ALTER TABLE user_certifications ENABLE ROW LEVEL SECURITY;

-- Catalog tables: read-only for authenticated users
DROP POLICY IF EXISTS "auth_read_skills" ON skills;
CREATE POLICY "auth_read_skills" ON skills FOR SELECT TO authenticated USING (true);

DROP POLICY IF EXISTS "auth_read_careers" ON careers;
CREATE POLICY "auth_read_careers" ON careers FOR SELECT TO authenticated USING (true);

DROP POLICY IF EXISTS "auth_read_career_skills" ON career_skills;
CREATE POLICY "auth_read_career_skills" ON career_skills FOR SELECT TO authenticated USING (true);

DROP POLICY IF EXISTS "auth_read_learning_resources" ON learning_resources;
CREATE POLICY "auth_read_learning_resources" ON learning_resources FOR SELECT TO authenticated USING (true);

DROP POLICY IF EXISTS "auth_read_industry_trends" ON industry_trends;
CREATE POLICY "auth_read_industry_trends" ON industry_trends FOR SELECT TO authenticated USING (true);

-- profiles: owner-scoped
DROP POLICY IF EXISTS "select_own_profile" ON profiles;
CREATE POLICY "select_own_profile" ON profiles FOR SELECT TO authenticated USING (auth.uid() = id);
DROP POLICY IF EXISTS "insert_own_profile" ON profiles;
CREATE POLICY "insert_own_profile" ON profiles FOR INSERT TO authenticated WITH CHECK (auth.uid() = id);
DROP POLICY IF EXISTS "update_own_profile" ON profiles;
CREATE POLICY "update_own_profile" ON profiles FOR UPDATE TO authenticated USING (auth.uid() = id) WITH CHECK (auth.uid() = id);
DROP POLICY IF EXISTS "delete_own_profile" ON profiles;
CREATE POLICY "delete_own_profile" ON profiles FOR DELETE TO authenticated USING (auth.uid() = id);

-- user_skills: owner-scoped
DROP POLICY IF EXISTS "select_own_user_skills" ON user_skills;
CREATE POLICY "select_own_user_skills" ON user_skills FOR SELECT TO authenticated USING (auth.uid() = user_id);
DROP POLICY IF EXISTS "insert_own_user_skills" ON user_skills;
CREATE POLICY "insert_own_user_skills" ON user_skills FOR INSERT TO authenticated WITH CHECK (auth.uid() = user_id);
DROP POLICY IF EXISTS "update_own_user_skills" ON user_skills;
CREATE POLICY "update_own_user_skills" ON user_skills FOR UPDATE TO authenticated USING (auth.uid() = user_id) WITH CHECK (auth.uid() = user_id);
DROP POLICY IF EXISTS "delete_own_user_skills" ON user_skills;
CREATE POLICY "delete_own_user_skills" ON user_skills FOR DELETE TO authenticated USING (auth.uid() = user_id);

-- recommendations: owner-scoped
DROP POLICY IF EXISTS "select_own_recommendations" ON recommendations;
CREATE POLICY "select_own_recommendations" ON recommendations FOR SELECT TO authenticated USING (auth.uid() = user_id);
DROP POLICY IF EXISTS "insert_own_recommendations" ON recommendations;
CREATE POLICY "insert_own_recommendations" ON recommendations FOR INSERT TO authenticated WITH CHECK (auth.uid() = user_id);
DROP POLICY IF EXISTS "update_own_recommendations" ON recommendations;
CREATE POLICY "update_own_recommendations" ON recommendations FOR UPDATE TO authenticated USING (auth.uid() = user_id) WITH CHECK (auth.uid() = user_id);
DROP POLICY IF EXISTS "delete_own_recommendations" ON recommendations;
CREATE POLICY "delete_own_recommendations" ON recommendations FOR DELETE TO authenticated USING (auth.uid() = user_id);

-- progress: owner-scoped
DROP POLICY IF EXISTS "select_own_progress" ON progress;
CREATE POLICY "select_own_progress" ON progress FOR SELECT TO authenticated USING (auth.uid() = user_id);
DROP POLICY IF EXISTS "insert_own_progress" ON progress;
CREATE POLICY "insert_own_progress" ON progress FOR INSERT TO authenticated WITH CHECK (auth.uid() = user_id);
DROP POLICY IF EXISTS "update_own_progress" ON progress;
CREATE POLICY "update_own_progress" ON progress FOR UPDATE TO authenticated USING (auth.uid() = user_id) WITH CHECK (auth.uid() = user_id);
DROP POLICY IF EXISTS "delete_own_progress" ON progress;
CREATE POLICY "delete_own_progress" ON progress FOR DELETE TO authenticated USING (auth.uid() = user_id);

-- user_projects: owner-scoped
DROP POLICY IF EXISTS "select_own_projects" ON user_projects;
CREATE POLICY "select_own_projects" ON user_projects FOR SELECT TO authenticated USING (auth.uid() = user_id);
DROP POLICY IF EXISTS "insert_own_projects" ON user_projects;
CREATE POLICY "insert_own_projects" ON user_projects FOR INSERT TO authenticated WITH CHECK (auth.uid() = user_id);
DROP POLICY IF EXISTS "update_own_projects" ON user_projects;
CREATE POLICY "update_own_projects" ON user_projects FOR UPDATE TO authenticated USING (auth.uid() = user_id) WITH CHECK (auth.uid() = user_id);
DROP POLICY IF EXISTS "delete_own_projects" ON user_projects;
CREATE POLICY "delete_own_projects" ON user_projects FOR DELETE TO authenticated USING (auth.uid() = user_id);

-- user_certifications: owner-scoped
DROP POLICY IF EXISTS "select_own_certs" ON user_certifications;
CREATE POLICY "select_own_certs" ON user_certifications FOR SELECT TO authenticated USING (auth.uid() = user_id);
DROP POLICY IF EXISTS "insert_own_certs" ON user_certifications;
CREATE POLICY "insert_own_certs" ON user_certifications FOR INSERT TO authenticated WITH CHECK (auth.uid() = user_id);
DROP POLICY IF EXISTS "update_own_certs" ON user_certifications;
CREATE POLICY "update_own_certs" ON user_certifications FOR UPDATE TO authenticated USING (auth.uid() = user_id) WITH CHECK (auth.uid() = user_id);
DROP POLICY IF EXISTS "delete_own_certs" ON user_certifications;
CREATE POLICY "delete_own_certs" ON user_certifications FOR DELETE TO authenticated USING (auth.uid() = user_id);